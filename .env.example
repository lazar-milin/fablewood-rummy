# Copy this file to .env and change what you need. `npm start` loads .env; never commit it.

# The address the server listens on. 127.0.0.1 keeps the game on this computer.
# Use HOST=0.0.0.0 to let other devices on your network join, or when your hosting
# provider requires it, for example in a container.
HOST=127.0.0.1
PORT=3010

# Set to true only when exactly one reverse proxy (for example your hosting
# provider's) forwards every request. Rate limits then count the player address
# the proxy appends to X-Forwarded-For instead of the proxy's own address.
TRUST_PROXY=false
